# ==========================================
# Frontend Configuration
# ==========================================
# ONLY set for local development (http://localhost:3000).
# Leave EMPTY or UNSET on Vercel so requests use relative /api routes.
VITE_API_BASE_URL=http://localhost:3000

# ==========================================
# Backend & Database Configuration (Vercel Environment Variables)
# ==========================
# 1. PostgreSQL Database URL (e.g. from https://neon.tech)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# 2. AI Chat & Assistant API Key (Google AI Studio Gemini / OpenAI)
# Add your Gemini API key in Vercel Environment Variables:
AI_API_KEY=your_gemini_api_key_here
# ==========================================
# Google OAuth Configuration (Google Identity Services)
# ==========================================
# Get credentials from Google Cloud Console: https://console.cloud.google.com/
# Authorized Origins:
#   Development: http://localhost:5173, http://localhost:3000
#   Production:  https://hum-saathi-ai.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here



