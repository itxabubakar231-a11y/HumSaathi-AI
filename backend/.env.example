# Database Connection (PostgreSQL from Neon/Supabase or local SQLite)
# Examples:
# PostgreSQL: postgresql://username:password@host/database?sslmode=require
# SQLite: sqlite:///./humsaathi.db
DATABASE_URL="sqlite:///./humsaathi.db"

# Server Port
PORT=8000

# CORS Allowed Origins (comma-separated or * for development)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,*"

# Gemini AI Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-1.5-flash

# Initial Server-Side Admin Setup (Set your secure credentials here)
ADMIN_EMAIL=admin@humsaathi.ai
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Google OAuth Configuration (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


