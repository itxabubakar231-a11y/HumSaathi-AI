{
  "name": "humsaathi-ai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "setup": "npm install && npm install --prefix frontend && npm install --prefix backend && npm run db:setup --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
